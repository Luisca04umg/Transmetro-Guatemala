@model PersonalVm
@{bool editar=User.HasClaim("permiso","PERSONAL_EDITAR");bool editarAcceso=User.HasClaim("permiso","ESTACIONES_EDITAR");bool editarLineas=User.HasClaim("permiso","LINEAS_EDITAR");bool editarEstaciones=editarAcceso;bool editarFlota=User.HasClaim("permiso","FLOTA_EDITAR");}
@if(Model.TipoFicha=="Piloto")
{
@foreach(var x in Model.Pilotos.Where(x=>x.PilotoID==Model.RegistroID)){<details class="record-detail" open data-search="@x.CodigoEmpleado @x.Nombres @x.Apellidos @x.Licencia"><summary>@x.CodigoEmpleado · @x.Nombres @x.Apellidos · @(x.Activo?"Activo":"Inactivo")</summary><partial name="_CamposRegistro" model="@(new RegistroVistaVm{Entidad=x})"/>@if(editar){<a asp-action="Editar" asp-route-tipo="Piloto" asp-route-id="@x.PilotoID">Editar piloto / desactivar</a>}
<h3>Historial educativo</h3>@foreach(var h in Model.Educacion.Where(h=>h.PilotoID==x.PilotoID)){<details class="record"><summary>@h.Nivel · @h.Institucion</summary><partial name="_CamposRegistro" model="@(new RegistroVistaVm{Entidad=h,Relaciones=new(){["PilotoID"]=$"{x.Nombres} {x.Apellidos}"}})"/>@if(editar){<a asp-action="Editar" asp-route-tipo="Educacion" asp-route-id="@h.HistorialEducativoID">Editar educación</a>}</details>}
@if(editar){<details><summary>Agregar historial educativo</summary><form asp-action="CrearEducacion" method="post" class="form-grid"><input type="hidden" name="PilotoID" value="@x.PilotoID"/><label>Nivel<select name="Nivel"><option>PRIMARIA</option><option>BASICOS</option><option>DIVERSIFICADO</option><option>TECNICO</option><option>UNIVERSITARIO</option><option>OTRO</option></select></label><label>Institución<input name="Institucion" required/></label><label>Título<input name="Titulo"/></label><label>Año de finalización<input name="AnioFinalizacion" type="number" min="1950" max="2100"/></label><label>Observación<input name="Observacion"/></label><button type="submit">Agregar educación</button></form></details>}
</details>}

}
@if(Model.TipoFicha=="Operador")
{
@foreach(var x in Model.Operadores.Where(x=>x.OperadorID==Model.RegistroID)){var asignaciones=Model.AsignacionesOperador.Where(a=>a.OperadorID==x.OperadorID&&a.FechaFin==null);<details class="record-detail" open data-search="@x.CodigoEmpleado @x.Nombres @x.Apellidos"><summary>@x.CodigoEmpleado · @x.Nombres @x.Apellidos · @(x.Activo?"Activo":"Inactivo")</summary><partial name="_CamposRegistro" model="@(new RegistroVistaVm{Entidad=x,Relaciones=new(){["Estaciones asignadas"]=string.Join(" · ",asignaciones.Select(a=>Model.Estaciones.FirstOrDefault(e=>e.EstacionID==a.EstacionID)?.Nombre))}})"/>@if(editar){<a asp-action="Editar" asp-route-tipo="Operador" asp-route-id="@x.OperadorID">Editar operador / desactivar</a><details><summary>Cambiar estación asignada</summary><form asp-action="AsignarOperador" method="post" class="form-grid"><input type="hidden" name="operadorID" value="@x.OperadorID"/><label>Estación<select name="estacionID">@foreach(var e in Model.Estaciones.Where(e=>e.Estado!="I")){<option value="@e.EstacionID" selected="@(asignaciones.Any(a=>a.EstacionID==e.EstacionID))">@e.Nombre</option>}</select></label><button type="submit">Guardar estación</button></form></details>}@foreach(var a in Model.AsignacionesOperador.Where(a=>a.OperadorID==x.OperadorID)){<details><summary>Asignación · @Model.Estaciones.FirstOrDefault(e=>e.EstacionID==a.EstacionID)?.Nombre · @(a.FechaFin is null?"Vigente":"Histórica")</summary><partial name="_CamposRegistro" model="@(new RegistroVistaVm{Entidad=a,Relaciones=new(){["EstacionID"]=Model.Estaciones.FirstOrDefault(e=>e.EstacionID==a.EstacionID)?.Nombre??"—"}})"/></details>}</details>}

}
@if(Model.TipoFicha=="Guardia")
{
@foreach(var x in Model.Guardias.Where(x=>x.GuardiaID==Model.RegistroID)){<details class="record-detail" open data-search="@x.CodigoEmpleado @x.Nombres @x.Apellidos @x.Empresa"><summary>@x.CodigoEmpleado · @x.Nombres @x.Apellidos · @(x.Activo?"Activo":"Inactivo")</summary><partial name="_CamposRegistro" model="@(new RegistroVistaVm{Entidad=x})"/>@if(editar){<a asp-action="Editar" asp-route-tipo="Guardia" asp-route-id="@x.GuardiaID">Editar guardia / desactivar</a><details><summary>Cambiar acceso o turno</summary><form asp-action="AsignarGuardia" method="post" class="form-grid"><input type="hidden" name="guardiaID" value="@x.GuardiaID"/><label>Acceso<select name="accesoID">@foreach(var e in Model.Accesos.Where(e=>e.Estado!="I")){<option value="@e.AccesoID" selected="@(Model.AsignacionesGuardia.Any(a=>a.GuardiaID==x.GuardiaID&&a.AccesoID==e.AccesoID&&a.FechaFin==null))">@e.Codigo · @e.Nombre</option>}</select></label><label>Turno<select name="turno">@foreach(var turno in new[]{"DIURNO","NOCTURNO","MIXTO"}){<option selected="@(Model.AsignacionesGuardia.Any(a=>a.GuardiaID==x.GuardiaID&&a.Turno==turno&&a.FechaFin==null))">@turno</option>}</select></label><button type="submit">Guardar acceso / turno</button></form></details>}@foreach(var a in Model.AsignacionesGuardia.Where(a=>a.GuardiaID==x.GuardiaID)){<details><summary>Acceso @Model.Accesos.FirstOrDefault(e=>e.AccesoID==a.AccesoID)?.Nombre · @a.Turno · @(a.FechaFin is null?"Vigente":"Histórica")</summary><partial name="_CamposRegistro" model="@(new RegistroVistaVm{Entidad=a,Relaciones=new(){["AccesoID"]=Model.Accesos.FirstOrDefault(e=>e.AccesoID==a.AccesoID)?.Nombre??"—"}})"/></details>}</details>}

}
@if(Model.TipoFicha=="Acceso")
{
@foreach(var x in Model.Accesos.Where(x=>x.AccesoID==Model.RegistroID)){var estacion=Model.Estaciones.FirstOrDefault(e=>e.EstacionID==x.EstacionID);<details class="record-detail" open data-search="@x.Codigo @x.Nombre @estacion?.Nombre"><summary>@x.Codigo · @x.Nombre · @estacion?.Nombre · @x.Estado</summary><partial name="_CamposRegistro" model="@(new RegistroVistaVm{Entidad=x,Relaciones=new(){["EstacionID"]=estacion?.Nombre??"—",["Guardias vigentes"]=string.Join(" · ",Model.AsignacionesGuardia.Where(a=>a.AccesoID==x.AccesoID&&a.FechaFin==null).Select(a=>$"{Model.Guardias.FirstOrDefault(g=>g.GuardiaID==a.GuardiaID)?.Nombres} {Model.Guardias.FirstOrDefault(g=>g.GuardiaID==a.GuardiaID)?.Apellidos} ({a.Turno})"))}})"/>@if(editarAcceso){<a asp-action="Editar" asp-route-tipo="Acceso" asp-route-id="@x.AccesoID">Editar acceso / desactivar</a>@if(x.Estado!="A"){<form asp-action="ActivarAcceso" method="post" class="inline-form"><input type="hidden" name="id" value="@x.AccesoID"/><button type="submit">Activar acceso</button></form>}}</details>}

}
